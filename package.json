{
  "name": "@sesamy/sesamy-components",
  "description": "Shareable web components library built with Vite + Svelte",
  "version": "2.23.0",
  "type": "module",
  "module": "dist/lib/sesamy-components.es.js",
  "main": "dist/lib/sesamy-components.umd.js",
  "types": "dist/lib/sesamy-components.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/sesamy-components.d.ts",
      "import": "./dist/lib/sesamy-components.es.js",
      "require": "./dist/lib/sesamy-components.umd.js"
    }
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sesamyab/sesamy-components.git"
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "yarn build:lib && yarn build:demo",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview": "vite preview --config vite.demo.config.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "prepublishOnly": "yarn run build:lib",
    "semantic-release": "semantic-release",
    "storybook:serve": "http-server storybook-static",
    "storybook": "yarn run build:lib && storybook dev -p 6006",
    "test": "yarn build:storybook && playwright test",
    "test:unit": "vitest run",
    "build:storybook": "yarn run build:lib && storybook build",
    "svg:generate": "svgo -f ./packages/lib/src/icons -o ./packages/lib/src/icons && node ./scripts/icon.js ./packages/lib/src/icons --generate-types",
    "pull-translations": "i18nexus pull -k UqoFFUDIqHedrUA4OlDXwg --path ./packages/lib/src/locales && prettier --write ./packages/lib/src/locales/**/*.json && yarn sort-translations",
    "push-translations": "i18nexus import ./packages/lib/src/locales/en/default.json -k UqoFFUDIqHedrUA4OlDXwg -ns default --overwrite",
    "sort-translations": "sort-json ./packages/lib/src/locales/**/*.json",
    "e2e": "docker run --rm --network host -v $(pwd):/work/ -v /work/node_modules -w /work/ mcr.microsoft.com/playwright:v1.62.1-noble@sha256:dcc5531e97840b9b5e794f2814476b21571c5124a3fca2267d73041f56e7580e sh -c 'yarn install && yarn build:storybook && yarn playwright test'",
    "e2e:snapshots": "docker run --rm --network host -v $(pwd):/work/ -v /work/node_modules -w /work/ mcr.microsoft.com/playwright:v1.62.1-noble@sha256:dcc5531e97840b9b5e794f2814476b21571c5124a3fca2267d73041f56e7580e sh -c 'yarn install && yarn build:storybook && yarn playwright test --update-snapshots'"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": true,
          "tarballDir": "dist"
        }
      ],
      "@semantic-release/github",
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "package.json"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ]
    ]
  },
  "devDependencies": {
    "@ape-egg/tailwind-rows-columns": "1.0.2",
    "@chromatic-com/storybook": "3.2.7",
    "@playwright/test": "1.62.1",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@sesamy/sesamy-js": "1.126.0",
    "@storybook/addon-controls": "8.6.18",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-interactions": "8.6.14",
    "@storybook/addon-links": "8.6.18",
    "@storybook/addon-svelte-csf": "4.2.0",
    "@storybook/blocks": "8.6.14",
    "@storybook/svelte": "8.6.18",
    "@storybook/svelte-vite": "8.6.18",
    "@storybook/test": "8.6.15",
    "@storybook/web-components": "8.6.18",
    "@storybook/web-components-vite": "8.6.18",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@tailwindcss/container-queries": "0.1.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/svelte": "5.4.2",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "24.13.3",
    "autoprefixer": "10.5.4",
    "http-server": "14.1.1",
    "i18nexus-cli": "3.8.3",
    "jsdom": "25.0.1",
    "lit": "3.2.1",
    "lit-html": "3.2.1",
    "postcss": "8.5.26",
    "postcss-nesting": "13.0.2",
    "postcss-value-parser": "4.2.0",
    "prettier": "3.5.3",
    "prettier-plugin-svelte": "3.5.2",
    "semantic-release": "25.0.9",
    "sort-json": "2.0.1",
    "storybook": "8.6.18",
    "svelte": "5.57.0",
    "svelte-check": "4.2.1",
    "svelte-preprocess": "6.0.5",
    "svgo": "3.3.5",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "3.4.19",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vite-plugin-static-copy": "3.4.0",
    "vitest": "3.2.7"
  },
  "files": [
    "dist/lib"
  ],
  "peerDependencies": {
    "@sesamy/sesamy-js": "1.126.0"
  },
  "dependencies": {
    "@zootools/email-spell-checker": "^1.12.0",
    "lucide-svelte": "^0.577.0",
    "svelte-tel-input": "^3.6.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
